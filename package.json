    "test:csv": "node scripts/test-csv-safety.mjs",
    "test:csp": "node scripts/test-csp-hashes.mjs",
    "test:depreciation": "node scripts/test-depreciation-engine.mjs",
    "test:currency": "node scripts/test-currency-engine.mjs",
    "test:brand": "python scripts/test-brand-refinement.py",
    "test:theme": "python scripts/test-theme-accessibility.py",
    "test:react-migration": "node scripts/test-react-migration.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "motion": "^12.23.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "firebase-tools": "14.0.0",
    "@playwright/test": "^1.56.1"
  }
