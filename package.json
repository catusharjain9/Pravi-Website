{
  "name": "pravi-business-advisors",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stage-legacy.mjs",
    "preview": "vite preview",
    "serve": "firebase emulators:start --only hosting,auth,firestore",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
